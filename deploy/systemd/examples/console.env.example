# /etc/fass/console.env — install mode 0600, owner root:fass.
# The console has no TLS listener of its own: bind it to loopback and put a TLS
# reverse proxy in front of it. It connects to an https coordinator using the
# cluster CA through Go's SSL_CERT_FILE support.
FASS_CONSOLE_LISTEN=127.0.0.1:8081
FASS_COORDINATOR_URL=https://coordinator.example.internal:7000
FASS_CONSOLE_USER=admin
FASS_CONSOLE_PASSWORD=CHANGEME_CONSOLE_PASSWORD
# true (default) disables the agent activate/decommission actions.
FASS_CONSOLE_READ_ONLY=true
SSL_CERT_FILE=/etc/fass/tls/ca/ca.crt
FASS_LOG_LEVEL=info
FASS_LOG_FORMAT=json
