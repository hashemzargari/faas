# /etc/fass/console.env — install mode 0600, owner root:fass.
# The console is a read-only UI by default and has no TLS of its own: bind it to
# loopback and put a TLS reverse proxy in front of it.
FASS_CONSOLE_LISTEN=127.0.0.1:8081
FASS_COORDINATOR_URL=http://127.0.0.1:7000
FASS_CONSOLE_USER=admin
FASS_CONSOLE_PASSWORD=CHANGEME_CONSOLE_PASSWORD
# true (default) disables the agent activate/decommission actions.
FASS_CONSOLE_READ_ONLY=true
FASS_LOG_LEVEL=info
FASS_LOG_FORMAT=json
