# /etc/fass/console.env — install mode 0600, owner root:fass.
# The console can serve HTTPS itself and present a clientAuth identity to a
# coordinator running --require-mtls. Without FASS_CONSOLE_TLS_* it serves
# plaintext HTTP and must sit behind a TLS reverse proxy.
FASS_CONSOLE_LISTEN=127.0.0.1:8081
FASS_COORDINATOR_URL=https://coordinator.example.internal:7000

# Coordinator client TLS: required for https://, plus a client certificate when
# the coordinator runs --require-mtls.
FASS_CONSOLE_COORDINATOR_CA=/etc/fass/tls/ca/ca.crt
FASS_CONSOLE_COORDINATOR_CLIENT_CERT=/etc/fass/tls/console-client/tls.crt
FASS_CONSOLE_COORDINATOR_CLIENT_KEY=/etc/fass/tls/console-client/tls.key
# FASS_CONSOLE_COORDINATOR_SERVER_NAME=coordinator.example.internal

# Console listener TLS (optional; browsers cannot easily present client certs,
# so --require-mtls here is usually a proxy's job).
FASS_CONSOLE_TLS_CERT=/etc/fass/tls/console/tls.crt
FASS_CONSOLE_TLS_KEY=/etc/fass/tls/console/tls.key
# FASS_CONSOLE_TLS_CLIENT_CA=/etc/fass/tls/ca/ca.crt
# FASS_CONSOLE_REQUIRE_MTLS=true

FASS_CONSOLE_USER=admin
FASS_CONSOLE_PASSWORD=CHANGEME_CONSOLE_PASSWORD
# true (default) disables the agent activate/decommission actions.
FASS_CONSOLE_READ_ONLY=true
# Kept for tooling that relies on Go's SSL_CERT_FILE default.
SSL_CERT_FILE=/etc/fass/tls/ca/ca.crt
FASS_LOG_LEVEL=info
FASS_LOG_FORMAT=json
