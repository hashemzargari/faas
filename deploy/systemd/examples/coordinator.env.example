# /etc/fass/coordinator.env — install mode 0640, owner root:fass.
# Every value is a FASS_COORDINATOR_* variable read by the binary.

FASS_COORDINATOR_LISTEN=127.0.0.1:7000
# Embedded-store data directory (dev/small installs). Empty means in-memory.
FASS_COORDINATOR_DATA_DIR=/var/lib/fass
FASS_COORDINATOR_LOG_LEVEL=info
FASS_COORDINATOR_LOG_FORMAT=json
# Set true during a planned announce freeze; it does not affect reads/writes.
FASS_COORDINATOR_MAINTENANCE=false
FASS_COORDINATOR_GC=true

# Transport security. TLS is REQUIRED outside --dev; the coordinator refuses to
# start without a server certificate. SANs must include every name peers dial:
# the coordinator's DNS name(s) and any service/VIP name used in
# FASS_COORDINATOR_URL by gateways/agents.
FASS_COORDINATOR_TLS_CERT=/etc/fass/tls/coordinator/tls.crt
FASS_COORDINATOR_TLS_KEY=/etc/fass/tls/coordinator/tls.key
# Strict mTLS: verify client certificates (agents/gateways) against the CA.
# Roll out in two steps: TLS on everywhere first, then enable this.
# FASS_COORDINATOR_TLS_CLIENT_CA=/etc/fass/tls/ca/ca.crt
# FASS_COORDINATOR_REQUIRE_MTLS=true
# Agents advertise https endpoints to gateways once TLS is on.
FASS_COORDINATOR_AGENT_SCHEME=https

# DEV ONLY plaintext opt-out (never on a real deployment):
# FASS_COORDINATOR_DEV=true

# Production persistence: PostgreSQL instead of the embedded store.
# Run migrations explicitly before starting/upgrading the coordinator:
#   set -a; . /etc/fass/coordinator.env; set +a; /usr/local/bin/fass-coordinator migrate
# FASS_COORDINATOR_DB_DRIVER=postgres
# FASS_COORDINATOR_DB_DSN=postgres://fass:CHANGEME@postgres.example:5432/fass?sslmode=require
# FASS_COORDINATOR_DB_MIGRATE_ON_START=false
