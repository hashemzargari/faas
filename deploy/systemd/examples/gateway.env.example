# /etc/fass/gateway.env — install mode 0600, owner root:fass.
# The key seed is tenant key material: treat this file as a secret.

FASS_GATEWAY_LISTEN=0.0.0.0:8080
FASS_GATEWAY_ADMIN_LISTEN=127.0.0.1:9000
FASS_COORDINATOR_URL=https://coordinator.example.internal:7000
FASS_GATEWAY_REGION=eu-west-1
FASS_GATEWAY_CHUNK_SIZE=16777216

# Must match the Redundancy Class the cluster was sized for.
FASS_GATEWAY_GEO_N=2
FASS_GATEWAY_GEO_K=1
FASS_GATEWAY_LOCAL_N=16
FASS_GATEWAY_LOCAL_K=4

# 64 hex characters. Losing it makes every object written with it unreadable.
# The KMIP-backed key service is not implemented in this release (docs/09).
FASS_GATEWAY_KEY_SEED=CHANGEME_64_HEX_CHARACTERS_0000000000000000000000000000

# --- TLS -------------------------------------------------------------------
# S3 edge listener (omit when an L4/LB terminates client TLS in front).
FASS_GATEWAY_TLS_CERT=/etc/fass/tls/gateway/tls.crt
FASS_GATEWAY_TLS_KEY=/etc/fass/tls/gateway/tls.key

# Data/control-plane trust: verify agents and the coordinator against the CA.
FASS_GATEWAY_CA_CERT=/etc/fass/tls/ca/ca.crt
FASS_GATEWAY_COORDINATOR_CA=/etc/fass/tls/ca/ca.crt
# Gateway client identity (clientAuth EKU) for agent + coordinator mTLS.
FASS_GATEWAY_CLIENT_CERT=/etc/fass/tls/gateway-client/tls.crt
FASS_GATEWAY_CLIENT_KEY=/etc/fass/tls/gateway-client/tls.key
# require = TLS-only peers (default); auto = mixed-mode rollout; off = plaintext
# only together with FASS_GATEWAY_INSECURE=true.
FASS_GATEWAY_AGENT_TLS=require
# Strict mTLS: reject plaintext peers and demand client certificates.
# FASS_GATEWAY_REQUIRE_MTLS=true

# DEV ONLY plaintext opt-out (never on a real deployment):
# FASS_GATEWAY_INSECURE=true

FASS_LOG_LEVEL=info
FASS_LOG_FORMAT=json
