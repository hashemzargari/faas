# /etc/fass/agent-<disk>.env — one file per disk, e.g. agent-disk0.env.
# Install mode 0600, owner root:fass. The announce secret is a one-time
# credential: mint it with POST /v1/agents/pending and delete/rotate the file
# after the agent has announced (the agent persists its identity on disk).

FASS_AGENT_DISK=/var/lib/fass/disks/disk0
FASS_AGENT_PORT=7100
FASS_AGENT_NEXUS_ID=nexus-a
FASS_AGENT_NODE_ID=node-a1
FASS_COORDINATOR_URL=http://10.0.0.10:7000
FASS_AGENT_SECRET=CHANGEME_ONE_TIME_ANNOUNCE_SECRET
FASS_AGENT_RESERVE_PCT=5
