# /etc/fass/agent-<disk>.env — one file per disk, e.g. agent-disk0.env.
# Install mode 0600, owner root:fass. The announce secret is a one-time
# credential: mint it with POST /v1/agents/pending; the agent then persists its
# identity on disk, and the file can be removed after the first announce.

FASS_AGENT_DISK=/var/lib/fass/disks/disk0
FASS_AGENT_PORT=7100
FASS_AGENT_NEXUS_ID=nexus-a
FASS_AGENT_NODE_ID=node-a1
FASS_COORDINATOR_URL=https://coordinator.example.internal:7000
FASS_AGENT_SECRET_FILE=/etc/fass/agents/disk0.secret
FASS_AGENT_RESERVE_PCT=5
# Agent-to-agent repair talks TLS too, so the same CA is required.
SSL_CERT_FILE=/etc/fass/tls/ca/ca.crt

# --- TLS -------------------------------------------------------------------
# Shard listener identity. SANs must include every name peers dial: with
# systemd the node FQDN and its management IP (gateways dial the announced
# hostname, which defaults to the OS hostname).
FASS_AGENT_TLS_CERT=/etc/fass/tls/agent/tls.crt
FASS_AGENT_TLS_KEY=/etc/fass/tls/agent/tls.key
FASS_AGENT_TLS_CA=/etc/fass/tls/ca/ca.crt
# Repair client identity (clientAuth EKU). Defaults to the server cert, which
# must then carry the clientAuth EKU; a dedicated cert is cleaner.
FASS_AGENT_TLS_CLIENT_CERT=/etc/fass/tls/agent-client/tls.crt
FASS_AGENT_TLS_CLIENT_KEY=/etc/fass/tls/agent-client/tls.key
# Strict mTLS for shard/repair peers.
# FASS_AGENT_REQUIRE_MTLS=true

# DEV ONLY plaintext opt-out (never on a real deployment):
# FASS_AGENT_INSECURE=true
